                                    (data.road ? 'ถนน ' + data.road + ' ' : '') + // Road or street name
                                    'แขวง ' + (data.subdistrictTh || '-') + ' ' + // Subdistrict name in Thai
                                    'เขต ' + (data.districtTh || '-') + ' ' + // District name in Thai
                                    'จังหวัด ' + (data.provinceTh || '-') + ' ' + // Province name in Thai

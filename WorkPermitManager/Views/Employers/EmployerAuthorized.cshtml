@{
    ViewData["Controller"] = "ทะเบียนสถานประกอบ/นายจ้าง";
    ViewData["Action"] = "ตั้งค่าการมอบอำนาจ";
    ViewData["Icon"] = "edit";
}
<!-- Container-fluid starts-->
<div class="container-fluid">
    <div class="row" style="display: none" id="showInsert">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <a class="btn btn-light" id="createOff" href="#" style="float:right"><i class="fa fa-close"></i> ยกเลิก</a>
                    <h4 id="createHeader"><i class="fa fa-plus text-dark"></i> เพิ่มข้อมูล</h4>
                    <h4 id="updateHeader" style="display:none"><i class="fa fa-edit"></i> แก้ไขข้อมูล</h4>
                </div>
                <div class="card-body">
                    <form id="myForm" class="row g-3" method="post" enctype="multipart/form-data">
                        <input class="form-control" name="EmployerAuthorizedPersonID" id="txtEmployerAuthorizedPersonID" type="hidden">
                        <input class="form-control" name="EmployerID" id="txtEmployerID" type="hidden" value="@ViewBag.EmployerID">
                        <div class="col-xxl-4 col-sm-4">
                            <label class="col-form-label" for="txtNameTh">ชื่อไทย</label>
                            <input class="form-control" name="NameTh" id="txtNameTh" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-4 col-sm-4">
                            <label class="col-form-label" for="txtNameEng">ชื่ออังกฤษ</label>
                            <input class="form-control" name="NameEng" id="txtNameEng" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-4 col-sm-4">
                            <label class="col-form-label" for="txtCompanyName">ชื่อบริษัท</label>
                            <input class="form-control" name="CompanyName" id="txtCompanyName" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="txtLicenseNumber">เลขที่ใบอนุญาต</label>
                            <input class="form-control" name="LicenseNumber" id="txtLicenseNumber" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="txtCardID">เลขบัตรประชาชน</label>
                            <input class="form-control" name="CardID" id="txtCardID" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtHouseNo">บ้านเลขที่</label>
                            <input class="form-control" name="HouseNo" id="txtHouseNo" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtVillageNo">หมู่ที่</label>
                            <input class="form-control" name="VillageNo" id="txtVillageNo" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtSoi">ซอย</label>
                            <input class="form-control" name="Soi" id="txtSoi" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtRoad">ถนน</label>
                            <input class="form-control" name="Road" id="txtRoad" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtSubdistrictTh">ตำบล</label>
                            <input class="form-control" name="SubdistrictTh" id="txtSubdistrictTh" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtDistrictTh">อำเภอ</label>
                            <input class="form-control" name="DistrictTh" id="txtDistrictTh" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtProvinceTh">จังหวัด</label>
                            <input class="form-control" name="ProvinceTh" id="txtProvinceTh" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-xxl-3 col-sm-3">
                            <label class="col-form-label" for="txtPhone">เบอร์โทรศัพท์</label>
                            <input class="form-control" name="Phone" id="txtPhone" type="text" placeholder="กรุณากรอกข้อมูล">
                        </div>
                        <div class="col-sm-12 col-xxl-12 col-12 justify-content-between d-flex">
                            <button class="btn btn-primary" id="createBtn" type="submit" title="btn btn-pill btn-success active">บันทึก</button>
                            <button class="btn btn-primary" id="updateBtn" type="submit" title="btn btn-pill btn-info active" style="display: none;">อัพเดท</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header pb-0 card-no-border">
                    <div class="ribbon ribbon-dark ribbon-clip">
                        <i class="fa fa-edit"></i> ตั้งค่าผู้มอบอำนาจ-รับมอบอำนาจ
                    </div>
                    <div class="d-flex gap-2 justify-end" style="float:right">
                        <a class="btn btn-success btn-sm" id="updateAuthorized" data-EmployerAuthorizationConfigID="@ViewBag.EmployerAuthorizationConfigID">
                            <i class="fa fa-edit text-white"></i> แก้ไข
                        </a>
                        <a class="btn btn-light btn-sm" asp-action="EmployersDetail" asp-controller="Employers" asp-route-EmployerID="@ViewBag.EmployerID">
                            <i class="fa fa-caret-left text-dark"></i> ย้อนกลับ
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th class="bg-light" scope="row">ผู้มอบอำนาจ</th>
                                <td>@ViewBag.AuthorizedPersonAssignor</td>
                            </tr>
                            <tr>
                                <th class="bg-light" scope="row">บริษัท</th>
                                <td>@ViewBag.AuthorizedCompanyAssignor</td>
                            </tr>
                            <tr>
                                <th class="bg-light" scope="row">ผู้รับมอบอำนาจ (ทั่วไป)</th>
                                <td>@ViewBag.AuthorizedPersonImport</td>
                            </tr>
                            <tr>
                                <th class="bg-light" scope="row">ผู้รับมอบอำนาจ (MOU)</th>
                                <td>@ViewBag.AuthorizedPersonMou</td>
                            </tr>
                            <tr>
                                <th class="bg-light" scope="row">พยาน 1</th>
                                <td>@ViewBag.AuthorizedWitness1</td>
                            </tr>
                            <tr>
                                <th class="bg-light" scope="row">พยาน 2</th>
                                <td>@ViewBag.AuthorizedWitness2</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="ribbon ribbon-primary ribbon-clip">
                        <i class="fa fa-users"></i> รายชื่อผู้มอบอำนาจ-รับมอบอำนาจ <i class="fa fa-caret-right"></i>  @ViewBag.EmployerName
                    </div>
                    <div class="d-flex gap-2 justify-end" style="float:right">
                        <a class="btn btn-primary btn-sm" id="createOn" href="#">
                            <i class="fa fa-plus text-white"></i> เพิ่มผู้มอบอำนาจ-รับมอบอำนาจ
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive theme-scrollbar mt-2">
                        <table class="display table table-bordered" id="data-source-1" style="width:100%">
                            <thead>
                                <tr>
                                    <th>ชื่อไทย</th>
                                    <th>ชื่ออังกฤษ</th>
                                    <th>บริษัท</th>
                                    <th class="text-center">รายละเอียด</th>
                                    <th>ดำเนินการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in (List<EmployerAuthorizedPerson>)ViewBag.EmployerAuthorizedPersonList)
                                {
                                    <tr>
                                        <td>@item.NameTh</td>
                                        <td>@item.NameEng</td>
                                        <td>@item.CompanyName</td>
                                        <td class="text-center">
                                            <a href="#" class="detailBtn text-dark" data-EmployerAuthorizedPersonID="@item.EmployerAuthorizedPersonID">
                                                <i class="fa fa-list-alt"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <ul class="action">
                                                <li class="edit">
                                                    <a href="#" class="editBtn" data-EmployerAuthorizedPersonID="@item.EmployerAuthorizedPersonID">
                                                        <i class="icon-pencil-alt"></i>
                                                    </a>
                                                </li>
                                                <li class="delete">
                                                    <a href="#" class="deleteBtn" data-EmployerAuthorizedPersonID="@item.EmployerAuthorizedPersonID">
                                                        <i class="icon-trash"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Container-fluid Ends-->
<!-- Add this modal structure to your HTML -->
<div class="modal fade" id="updateAuthorizedModal" tabindex="-1" aria-labelledby="updateAuthorizedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateAuthorizedModalLabel"><i class="fa fa-edit"></i> แก้ไขผู้มอบอำนาจ-รับมอบอำนาจ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Modal Form -->
                <form id="updateAuthorizedForm">
                    <input type="hidden" id="EmployerAuthorizationConfigID" name="EmployerAuthorizationConfigID" value="@ViewBag.EmployerAuthorizationConfigID">
                    <input type="hidden" id="ddEmployerID" name="EmployerID" value="@ViewBag.EmployerID">
                    <div class="mb-3">
                        <label for="AuthorizedPersonAssignorID" class="form-label">ผู้มอบอำนาจ</label>
                        <select class="form-select" id="AuthorizedPersonAssignorID" name="AuthorizedPersonAssignorID">
                            @foreach (var person in ViewBag.EmployerAuthorizedPersonList)
                            {
                                <option value="@person.EmployerAuthorizedPersonID">@person.NameTh</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="AuthorizedPersonImportID" class="form-label">ผู้รับมอบอำนาจ (ทั่วไป)</label>
                        <select class="form-select" id="AuthorizedPersonImportID" name="AuthorizedPersonImportID">
                            @foreach (var person in ViewBag.EmployerAuthorizedPersonList)
                            {
                                <option value="@person.EmployerAuthorizedPersonID">@person.NameTh</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="AuthorizedPersonMouID" class="form-label">ผู้รับมอบอำนาจ (MOU)</label>
                        <select class="form-select" id="AuthorizedPersonMouID" name="AuthorizedPersonMouID">
                            @foreach (var person in ViewBag.EmployerAuthorizedPersonList)
                            {
                                <option value="@person.EmployerAuthorizedPersonID">@person.NameTh</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="AuthorizedWitness1ID" class="form-label">พยาน 1</label>
                        <select class="form-select" id="AuthorizedWitness1ID" name="AuthorizedWitness1ID">
                            @foreach (var person in ViewBag.EmployerAuthorizedPersonList)
                            {
                                <option value="@person.EmployerAuthorizedPersonID">@person.NameTh</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="AuthorizedWitness2ID" class="form-label">พยาน 2</label>
                        <select class="form-select" id="AuthorizedWitness2ID" name="AuthorizedWitness2ID">
                            @foreach (var person in ViewBag.EmployerAuthorizedPersonList)
                            {
                                <option value="@person.EmployerAuthorizedPersonID">@person.NameTh</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">ปิด</button>
                        <button type="submit" class="btn btn-primary">บันทึก</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailModalLabel"><i class="fa fa-list-alt"></i> รายละเอียดผู้มอบอำนาจ-รับมอบอำนาจ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th class="bg-light" scope="row">ชื่อไทย</th>
                            <td><span id="detailNameTh"></span></td>
                        </tr>
                        <tr>
                            <th class="bg-light" scope="row">ชื่ออังกฤษ</th>
                            <td><span id="detailNameEng"></span></td>
                        </tr>
                        <tr>
                            <th class="bg-light" scope="row">เลขที่ใบอนุญาต</th>
                            <td><span id="detailLicenseNumber"></span></td>
                        </tr>
                        <tr>
                            <th class="bg-light" scope="row">ชื่อบริษัท</th>
                            <td><span id="detailCompanyName"></span></td>
                        </tr>
                        <tr>
                            <th class="bg-light" scope="row">เลขบัตรประชาชน</th>
                            <td><span id="detailCardID"></span></td>
                        </tr>
                        <tr>
                            <th class="bg-light" scope="row">เบอร์โทรศัพท์</th>
                            <td><span id="detailPhone"></span></td>
                        </tr>
                        <tr>
                            <th class="bg-light" scope="row">ที่อยู่</th>
                            <td><span id="detailAddress"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var showInsert = document.getElementById('showInsert');
            var createOn = document.getElementById('createOn');
            var createOff = document.getElementById('createOff');

            // Event listener for "เพิ่ม" button
            createOn.addEventListener('click', function (e) {
                e.preventDefault();
                showInsert.style.display = 'block';  // Show the form
            });

            // Event listener for "ยกเลิกเพิ่ม" button
            createOff.addEventListener('click', function (e) {
                e.preventDefault();
                showInsert.style.display = 'none';  // Hide the form
                // Reset the form fields
                $('#myForm')[0].reset();
                // Hide the EmployerAuthorizedPersonID field and update button
                $('#txtEmployerAuthorizedPersonID').hide();
                $('#updateBtn').hide();
                // Show the create button and header
                $('#createHeader').show();
                $('#updateHeader').hide();
                $('#createBtn').show();
                // Hide the cancel button
                $('#cancelBtn').hide();
            });

            document.getElementById('updateAuthorized').addEventListener('click', function (e) {
                e.preventDefault();
                var employerAuthorizationConfigID = this.getAttribute('data-EmployerAuthorizationConfigID');
                $('#EmployerAuthorizationConfigID').val(employerAuthorizationConfigID);
                $('#updateAuthorizedModal').modal('show');
            });

            $('#updateAuthorizedForm').on('submit', function (e) {
                e.preventDefault();
                var formData = $(this).serialize();

                Swal.fire({
                    title: 'คุณแน่ใจหรือไม่?',
                    text: "คุณต้องการบันทึกการเปลี่ยนแปลงนี้หรือไม่?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'ใช่, บันทึก!',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("UpdateEmployerAuthorizationConfig", "Employers")',
                            type: 'POST',
                            data: formData,
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('สำเร็จ', 'ข้อมูลถูกบันทึกแล้ว', 'success').then((result) => {
                                        if (result.isConfirmed) {
                                            window.location.reload();
                                        }
                                    });
                                } else {
                                    Swal.fire('ผิดพลาด', response.message, 'error');
                                }
                            },
                            error: function (xhr, textStatus, errorThrown) {
                                console.error('Error:', xhr.status, textStatus, errorThrown);
                                handleAjaxError(xhr);
                            }
                        });
                    }
                });
            });
        });



        document.querySelectorAll('.detailBtn').forEach(function (button) {
             button.addEventListener('click', function (e) {
                 e.preventDefault();
                 var employerAuthorizedPersonID = this.getAttribute('data-EmployerAuthorizedPersonID');

                 $.ajax({
                     url: '@Url.Action("GetEmployerAuthorizedPersonDetails", "Employers")',
                     type: 'POST',
                     data: { EmployerAuthorizedPersonID: employerAuthorizedPersonID },
                     success: function (response) {
                         if (response.success == false) {
                             Swal.fire('ผิดพลาด', response.message, 'error');
                         } else {
                            $('#detailNameTh').text(response.nameTh || '-');
                            $('#detailNameEng').text(response.nameEng || '-');
                            $('#detailLicenseNumber').text(response.licenseNumber || '-');
                            $('#detailCompanyName').text(response.companyName || '-');
                            $('#detailCardID').text(response.cardID || '-');
                            $('#detailPhone').text(response.phone || '-');
                            $('#detailAddress').text(
                                'บ้านเลขที่ ' + (response.houseNo || '-') + ' ' +
                                'หมู่ที่ ' + (response.villageNo || '-') + ' ' +
                                'ซอย ' + (response.soi || '-') + ' ' +
                                'ถนน ' + (response.road || '-') + ' ' +
                                'ตำบล ' + (response.subdistrictTh || '-') + ' ' +
                                'อำเภอ ' + (response.districtTh || '-') + ' ' +
                                'จังหวัด ' + (response.provinceTh || '-')
                            );

                             $('#detailModal').modal('show');
                         }
                     },
                     error: function (xhr, textStatus, errorThrown) {
                         console.error('Error:', xhr.status, textStatus, errorThrown);
                         handleAjaxError(xhr);
                     }
                 });
             });
         });

        // เพิ่มข้อมูลผู้มีอำนาจของนายจ้าง
        document.getElementById('createBtn').addEventListener('click', function (e) {
            e.preventDefault();

            var nameTh = $('#txtNameTh').val();
            var nameEng = $('#txtNameEng').val();

            if (!nameTh || !nameEng) {
                Swal.fire({
                    icon: 'error',
                    title: 'กรุณากรอกชื่อไทยและชื่ออังกฤษ',
                    text: 'กรุณากรอกชื่อไทยและชื่ออังกฤษก่อนดำเนินการต่อ',
                });
                return;
            }

            $.ajax({
                url : `@Url.Action("CheckEmployerAuthorizedPersonName", "Employers")`,
                type: 'POST',
                data: { NameTh: nameTh, NameEng: nameEng },
                success: function (response) {
                    if (response.success == false) {
                        Swal.fire('ผิดพลาด', response.message, 'error');
                    } else {
                        Swal.fire({
                            title: 'คุณแน่ใจหรือไม่?',
                            text: "คุณจะไม่สามารถย้อนกลับได้!",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#28a745', // Light green
                            cancelButtonColor: '#d3d3d3', // Light gray
                            confirmButtonText: 'ใช่, บันทึก!',
                            cancelButtonText: 'ยกเลิก'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $.ajax({
                                    url: '@Url.Action("CreateEmployerAuthorizedPerson", "Employers")',
                                    type: 'POST',
                                    data: {
                                        EmployerID: $('#txtEmployerID').val(),
                                        NameTh: nameTh,
                                        NameEng: nameEng,
                                        LicenseNumber: $('#txtLicenseNumber').val(),
                                        CompanyName: $('#txtCompanyName').val(),
                                        CardID: $('#txtCardID').val(),
                                        HouseNo: $('#txtHouseNo').val(),
                                        VillageNo: $('#txtVillageNo').val(),
                                        Soi: $('#txtSoi').val(),
                                        Road: $('#txtRoad').val(),
                                        SubdistrictTh: $('#txtSubdistrictTh').val(),
                                        DistrictTh: $('#txtDistrictTh').val(),
                                        ProvinceTh: $('#txtProvinceTh').val(),
                                        Phone: $('#txtPhone').val()
                                    },
                                    success: function (response) {
                                        if (response.success == true) {
                                            Swal.fire(
                                                'บันทึกแล้ว!',
                                                'ข้อมูลของคุณถูกบันทึกแล้ว.',
                                                'success'
                                            ).then((result) => {
                                                if (result.isConfirmed) {
                                                    window.location.reload();
                                                }
                                            });
                                        } else {
                                            Swal.fire('ผิดพลาด', response.message, 'error');
                                        }
                                    },
                                    error: function (xhr, textStatus, errorThrown) {
                                        console.error('Error:', xhr.status, textStatus, errorThrown);
                                        handleAjaxError(xhr);
                                    }
                                });
                            }
                        });
                    }
                },
            });
        });

        // แก้ไขข้อมูลผู้มีอำนาจของนายจ้าง
        document.querySelectorAll('.editBtn').forEach(function (button) {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                var employerAuthorizedPersonID = this.getAttribute('data-EmployerAuthorizedPersonID');

                $.ajax({
                    url: '@Url.Action("GetEmployerAuthorizedPersonDetails", "Employers")',
                    type: 'POST',
                    data: { EmployerAuthorizedPersonID: employerAuthorizedPersonID },
                    success: function (response) {
                        if (response.success == false) {
                            Swal.fire('ผิดพลาด', response.message, 'error');
                        } else {
                            $('#showInsert').show();
                            $('#txtEmployerAuthorizedPersonID').val(response.employerAuthorizedPersonID);
                            $('#txtEmployerID').val(response.employerID);
                            $('#txtNameTh').val(response.nameTh);
                            $('#txtNameEng').val(response.nameEng);
                            $('#txtLicenseNumber').val(response.licenseNumber);
                            $('#txtCompanyName').val(response.companyName);
                            $('#txtCardID').val(response.cardID);
                            $('#txtHouseNo').val(response.houseNo);
                            $('#txtVillageNo').val(response.villageNo);
                            $('#txtSoi').val(response.soi);
                            $('#txtRoad').val(response.road);
                            $('#txtSubdistrictTh').val(response.subdistrictTh);
                            $('#txtDistrictTh').val(response.districtTh);
                            $('#txtProvinceTh').val(response.provinceTh);
                            $('#txtPhone').val(response.phone);

                            $('#createHeader').hide();
                            $('#updateHeader').show();
                            $('#createBtn').hide();
                            $('#updateBtn').show();
                        }
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        console.error('Error:', xhr.status, textStatus, errorThrown);
                        handleAjaxError(xhr);
                    }
                });
            });
        });

        // ลบข้อมูลผู้มีอำนาจของนายจ้าง
        document.querySelectorAll('.deleteBtn').forEach(function (button) {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                var employerAuthorizedPersonID = this.getAttribute('data-EmployerAuthorizedPersonID');

                Swal.fire({
                    title: 'คุณแน่ใจหรือไม่?',
                    text: "คุณจะไม่สามารถย้อนกลับได้!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#d3d3d3',
                    confirmButtonText: 'ใช่, ลบ!',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteEmployerAuthorizedPerson", "Employers")',
                            type: 'POST',
                            data: { EmployerAuthorizedPersonID: employerAuthorizedPersonID },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire(
                                        'ลบแล้ว!',
                                        response.message,
                                        'success'
                                    ).then((result) => {
                                        if (result.isConfirmed) {
                                            window.location.reload();
                                        }
                                    });
                                } else {
                                    Swal.fire('ผิดพลาด', response.message, 'error');
                                }
                            },
                            error: function (xhr, textStatus, errorThrown) {
                                console.error('Error:', xhr.status, textStatus, errorThrown);
                                handleAjaxError(xhr);
                            }
                        });
                    }
                });
            });
        });

        document.getElementById('updateBtn').addEventListener('click', function (e) {
            e.preventDefault();

            var employerAuthorizedPersonID = $('#txtEmployerAuthorizedPersonID').val();
            var nameTh = $('#txtNameTh').val();
            var nameEng = $('#txtNameEng').val();

            Swal.fire({
                title: 'คุณแน่ใจหรือไม่?',
                text: "คุณจะไม่สามารถย้อนกลับได้!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#007bff', // Light blue
                cancelButtonColor: '#d3d3d3', // Light gray
                confirmButtonText: 'ใช่, บันทึก!',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Save the data here
                    $.ajax({
                        url: '@Url.Action("UpdateEmployerAuthorizedPerson", "Employers")', // manually specify the URL
                        type: 'POST',
                        data: {
                            EmployerAuthorizedPersonID: employerAuthorizedPersonID,
                            EmployerID: $('#txtEmployerID').val(),
                            NameTh: nameTh,
                            NameEng: nameEng,
                            LicenseNumber: $('#txtLicenseNumber').val(),
                            CompanyName: $('#txtCompanyName').val(),
                            CardID: $('#txtCardID').val(),
                            HouseNo: $('#txtHouseNo').val(),
                            VillageNo: $('#txtVillageNo').val(),
                            Soi: $('#txtSoi').val(),
                            Road: $('#txtRoad').val(),
                            SubdistrictTh: $('#txtSubdistrictTh').val(),
                            DistrictTh: $('#txtDistrictTh').val(),
                            ProvinceTh: $('#txtProvinceTh').val(),
                            Phone: $('#txtPhone').val()
                        },
                        success: function (response) {
                            if (response.success == true) {
                                Swal.fire(
                                    'บันทึกแล้ว!',
                                    'ข้อมูลของคุณถูกบันทึกแล้ว.',
                                    'success'
                                ).then((result) => {
                                    if (result.isConfirmed) {
                                        window.location.reload();
                                    }
                                })
                            } else {
                                Swal.fire('ผิดพลาด', response.message, 'error');
                            }
                        },
                        error: function (xhr, textStatus, errorThrown) {
                            handleAjaxError(xhr);
                        }
                    });
                }
            });
        });

         function handleAjaxError(xhr) {
            console.log('Error:', xhr.status, xhr.statusText);

            switch (xhr.status) {
                case 400:
                    window.open('@Url.Action("Error400", "Error")', '_blank');
                    break;
                case 401:
                    window.open('@Url.Action("Error401", "Error")', '_blank');
                    break;
                case 403:
                    window.open('@Url.Action("Error403", "Error")', '_blank');
                    break;
                case 404:
                    window.open('@Url.Action("Error404", "Error")', '_blank');
                    break;
                case 500:
                    window.open('@Url.Action("Error500", "Error")', '_blank');
                    break;
                case 503:
                    window.open('@Url.Action("Error503", "Error")', '_blank');
                    break;
                default:
                    console.log('An unexpected error occurred: ', xhr.status);
            }
        }
    </script>
}

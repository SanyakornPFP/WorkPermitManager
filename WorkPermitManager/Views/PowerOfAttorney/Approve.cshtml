<!-- #region LogSystemData -->
@{
    ViewData["Controller"] = "หนังสือมอบอำนาจ";
    ViewData["Action"] = "อนุมัติคำขอมอบอำนาจ";
    ViewData["Icon"] = "check-square-o";
}
<div class="container-fluid">
    <div class="row">
        <div class="col-xl-4 col-sm-6" id="waitapproved">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-primary text-white border-0 rounded-top-4 pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="fa fa-clock-o me-2"></i>ต้องอนุมัติ</h5>
                        <a class="btn btn-sm btn-pill @(ViewBag.TypeForm == "รอการอนุมัติ" ? "btn-light text-primary border-primary" : "btn-outline-light")"
                           asp-controller="PowerOfAttorney" asp-action="Approve" asp-route-type="รอการอนุมัติ">
                            รายละเอียด
                        </a>
                    </div>
                </div>
                <div class="card-body bg-light rounded-bottom-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="flex-shrink-0 bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                            <i class="fa fa-clock-o text-white fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h2 id="waitapproved-count" class="mb-0 fw-bold text-primary">0</h2>
                            <p class="text-muted mb-0">รายการ</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6" id="approved">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-success text-white border-0 rounded-top-4 pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="fa fa-check-circle me-2"></i>อนุมัติเรียบร้อย</h5>
                        <a class="btn btn-sm btn-pill @(ViewBag.TypeForm == "อนุมัติเรียบร้อย" ? "btn-light text-success border-success" : "btn-outline-light")"
                           asp-controller="PowerOfAttorney" asp-action="Approve" asp-route-type="อนุมัติเรียบร้อย">
                            รายละเอียด
                        </a>
                    </div>
                </div>
                <div class="card-body bg-light rounded-bottom-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="flex-shrink-0 bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                            <i class="fa fa-check-circle text-white fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h2 id="approved-count" class="mb-0 fw-bold text-success">0</h2>
                            <p class="text-muted mb-0">รายการ</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6" id="notapproved">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-danger text-white border-0 rounded-top-4 pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="fa fa-times-circle me-2"></i>ไม่อนุมัติ</h5>
                        <a class="btn btn-sm btn-pill @(ViewBag.TypeForm == "ไม่อนุมัติ" ? "btn-light text-danger border-danger" : "btn-outline-light")"
                           asp-controller="PowerOfAttorney" asp-action="Approve" asp-route-type="ไม่อนุมัติ">
                            รายละเอียด
                        </a>
                    </div>
                </div>
                <div class="card-body bg-light rounded-bottom-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="flex-shrink-0 bg-danger bg-gradient rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                            <i class="fa fa-times-circle text-white fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h2 id="notapproved-count" class="mb-0 fw-bold text-danger">0</h2>
                            <p class="text-muted mb-0">รายการ</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header pb-0 card-no-border">
                    <div class="ribbon ribbon-primary ribbon-clip">
                        <i class="fa fa-check-square-o text-white"></i> อนุมัติคำขอมอบอำนาจ
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive theme-scrollbar mt-3">
                        <table class="display table table-bordered" id="data-source-1" style="width:100%">
                            <thead>
                                <tr>
                                    <th>รหัสคำขอ</th>
                                    <th>ผู้มอบอำนาจ</th>
                                    <th>ผู้รับมอบอำนาจ</th>
                                    <th>วันที่ยื่นขอ</th>
                                    <th>สถานะ</th>
                                    <th class="text-center">อายุเอกสาร</th>
                                    <th class="text-center">เอกสาร</th>
                                    <th class="text-center">รายละเอียด</th>
                                    @if (ViewBag.TypeForm == "รอการอนุมัติ")
                                    {
                                        <th class="text-center">อนุมัติ</th>
                                        <th class="text-center">ไม่อนุมัติ</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ViewBag.PowerOfAttorneysList)
                                {
                                    <tr>
                                        <td>@item.CodeForm</td>
                                        <td>@item.GrantorName</td>
                                        <td>@item.AttorneyName</td>
                                        <td>@item.CreationDate</td>
                                        <td>
                                            <span class="badge @(item.Status == "รอการอนุมัติ" ? "badge-warning" : item.Status == "ไม่อนุมัติ" ? "badge-danger" : item.Status == "อนุมัติเรียบร้อย" ? "badge-success" : "badge-light")" style="font-size: 0.8rem">@item.Status</span>
                                        </td>
                                        <td class="text-center">@(item.TotalDate < 0 ? "0" : item.TotalDate) </td>
                                        <td class="text-center">
                                            <a class="text-primary reportForm btn btn-light btn-sm" data-codeForm="@item.CodeForm">
                                                <i class="fa fa-file-pdf-o text-danger" aria-hidden="true"></i> <span class="text-dark">PDF</span>
                                            </a>
                                        </td>
                                        <td class="text-center">
                                            <!-- ปุ่มที่เปิด Modal -->
                                            <button class="btn text-dark" data-toggle="modal" data-target="#detailModal" data-powerofattorneyid="@item.PowerOfAttorneyID">
                                                <i class="icofont icofont-list"></i>
                                            </button>
                                        </td>
                                        @if (ViewBag.TypeForm == "รอการอนุมัติ")
                                        {
                                            <td class="text-center">
                                                <button class="btn text-success approveBtn" data-powerofattorneyid="@item.PowerOfAttorneyID">
                                                    <i class="icofont icofont-checked"></i>
                                                </button>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn text-danger notApproveBtn" data-powerofattorneyid="@item.PowerOfAttorneyID">
                                                    <i class="icofont icofont-close-squared"></i>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap 5 Modal -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow rounded-4">
            <div class="modal-header  text-white ">
                <h6 class="modal-title d-flex align-items-center" id="detailModalLabel">
                    <i class="fa fa-list-alt me-2"></i> รายละเอียดเพิ่มเติมหนังสือมอบอำนาจ
                </h6>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover align-middle mb-4 rounded-3 overflow-hidden">
                        <tbody>
                            <tr>
                                <td class="bg-primary text-white"><i class="fa fa-barcode me-1"></i> รหัสคำขอ</td>
                                <td id="CodeForm"></td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-calendar me-1"></i> วันที่ยื่นขอ</td>
                                <td id="CreationDate"></td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-users me-1"></i> จำนวนที่ใช้บริการ</td>
                                <td id="TotalPeople"></td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-sticky-note me-1"></i> หมายเหตุขอใช้งาน</td>
                                <td id="Remark"></td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-user me-1"></i> ผู้มอบอำนาจ</td>
                                <td id="GrantorName"></td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-check-circle me-1"></i> สถานะการอนุมัติ</td>
                                <td id="GrantorStatus"></td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-calendar-check-o me-1"></i> วันที่อนุมัติ</td>
                                <td id="GrantorDateApprove"></td>
                            </tr>
                            <tr>
                                <td><i class="fa fa-user me-1"></i> ผู้รับมอบอำนาจ</td>
                                <td id="AttorneyName"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-white">
                <button type="button" class="btn btn-outline-primary" data-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> ปิด
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#detailModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // ปุ่มที่ถูกคลิก
                var powerOfAttorneyID = button.data('powerofattorneyid'); // ค่า UserID จาก data attribute

                // ส่ง AJAX request เพื่อดึงรายละเอียดโดยใช้ UserID
                $.ajax({
                    url: '@Url.Action("GetPowerOfAttorneyModel", "PowerOfAttorney")', // เปลี่ยนเป็น URL ของ Controller และ Action
                    type: 'POST',
                    data: { PowerOfAttorneyID: powerOfAttorneyID }, // ส่งค่า UserID
                    success: function (response) { // เมื่อ AJAX สำเร็จ
                        if (response.success === false) {
                            Swal.fire('ผิดพลาด', response.message, 'error');
                        } else {
                            var data = response.data;
                            $('#CodeForm').text(data.codeForm);
                            $('#CreationDate').text(data.creationDate);
                            $('#TotalPeople').text(data.totalPeople);
                            $('#GrantorName').text(data.grantorName);
                            $('#GrantorStatus').text(data.status);
                            $('#GrantorDateApprove').text(data.grantorDateApprove ?? 'ไม่พบข้อมูล');
                            $('#AttorneyName').text(data.attorneyName);
                            $('#Remark').text(data.remark);
                        }
                    },
                    error: function (xhr, status, error) { // เมื่อ AJAX ล้มเหลว
                        console.error('Error:', xhr.status, status, error);
                          handleAjaxError(xhr);
                    }
                });
            });

            $.ajax({
                url: '@Url.Action("DocumentCountStatus", "PowerOfAttorney")',
                type: 'POST',
                success: function(data) {
                    console.log(data);
                    $('#waitapproved-count').text(data.waitapproval);
                    $('#approved-count').text(data.approved);
                    $('#notapproved-count').text(data.notapproved);
                    $('#canceled-count').text(data.canceled);
                },
                error: function(error) {
                    console.log('Error:', error);
                }
            });

            $.ajax({
                url: '@Url.Action("DocumentCountStatusApprove", "PowerOfAttorney")',
                type: 'POST',
                success: function(data) {
                    console.log(data);
                    $('#waitapproved-count').text(data.waitapproval);
                    $('#approved-count').text(data.approved);
                    $('#canceled-count').text(data.canceled);
                },
                error: function(error) {
                    console.log('Error:', error);
                }
            });

        });

            document.addEventListener('DOMContentLoaded', function () {
            // Approve Button
            document.querySelectorAll('.approveBtn').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var powerOfAttorneyID = this.getAttribute('data-powerofattorneyid');

                    Swal.fire({
                        title: 'คุณแน่ใจหรือไม่?',
                        text: "คุณจะไม่สามารถย้อนกลับได้!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#007bff', // Light blue
                        cancelButtonColor: '#d3d3d3', // Light gray
                        confirmButtonText: 'ใช่, อนุมัติคำขอ!',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '@Url.Action("ApprovePowerOfAttorney", "PowerOfAttorney")',
                                type: 'POST',
                                data: {
                                    PowerOfAttorneyID: powerOfAttorneyID
                                },
                                success: function (response) {
                                    if (response.success) {
                                        Swal.fire(
                                            'อนุมัติเรียบร้อย !',
                                            'ข้อมูลของคุณถูกบันทึกแล้ว.',
                                            'success'
                                        ).then((result) => {
                                            if (result.isConfirmed) {
                                                window.location.reload();
                                            }
                                        });
                                    } else {
                                        Swal.fire('ผิดพลาด', response.message, 'error');
                                    }
                                },
                                error: function (xhr, textStatus, errorThrown) {
                                    console.error('Error:', xhr.status, textStatus, errorThrown);
                                    Swal.fire('ผิดพลาด', 'เกิดข้อผิดพลาดในการส่งคำขอ', 'error');
                                }
                            });
                        }
                    });
                });
            });

            document.querySelectorAll('.reportForm').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();

                    const codeForm = this.getAttribute('data-codeForm');

                    if (!codeForm) {
                        Swal.fire('Error', 'Invalid CodeForm value.', 'error');
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("ReportForm", "PowerOfAttorney")',
                        type: 'GET',
                        data: { CodeForm: codeForm },
                        xhrFields: { responseType: 'blob' },
                        success: function (response) {
                            const blob = new Blob([response], { type: 'application/pdf' });
                            const fileURL = window.URL.createObjectURL(blob);
                            window.open(fileURL, '_blank');
                        },
                        error: function (xhr) {
                            const errorMessage = xhr.responseJSON?.message || 'Cannot generate the document.';
                            Swal.fire('Error', errorMessage, 'error');
                        }
                    });
                });
            });

            // Not Approve Button
            document.querySelectorAll('.notApproveBtn').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var powerOfAttorneyID = this.getAttribute('data-powerofattorneyid');

                    Swal.fire({
                        title: 'คุณแน่ใจหรือไม่?',
                        text: "คุณจะไม่สามารถย้อนกลับได้!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33', // Red
                        cancelButtonColor: '#d3d3d3', // Light gray
                        confirmButtonText: 'ใช่, ไม่อนุมัติคำขอ!',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '@Url.Action("NotApprovePowerOfAttorney", "PowerOfAttorney")',
                                type: 'POST',
                                data: {
                                    PowerOfAttorneyID: powerOfAttorneyID
                                },
                                success: function (response) {
                                    if (response.success) {
                                        Swal.fire(
                                            'ไม่อนุมัติเรียบร้อย !',
                                            'ข้อมูลของคุณถูกบันทึกแล้ว.',
                                            'success'
                                        ).then((result) => {
                                            if (result.isConfirmed) {
                                                window.location.reload();
                                            }
                                        });
                                    } else {
                                        Swal.fire('ผิดพลาด', response.message, 'error');
                                    }
                                },
                                error: function (xhr, textStatus, errorThrown) {
                                    console.error('Error:', xhr.status, textStatus, errorThrown);
                                    Swal.fire('ผิดพลาด', 'เกิดข้อผิดพลาดในการส่งคำขอ', 'error');
                                }
                            });
                        }
                    });
                });
            });
        });
    </script>
}
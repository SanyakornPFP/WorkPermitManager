@{
    ViewData["Controller"] = "งานบริการ";
    ViewData["Action"] = "ข้อมูลแรงงาน";
    ViewData["Icon"] = "paste";
    int countRow = 0;
}
<!-- Container-fluid starts-->
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="ribbon ribbon-primary ribbon-clip">
                        <i class="fa fa-paste"></i> รายละเอียดงานบริการ
                    </div>
                    <div class="d-flex gap-2 justify-end" style="float:right">
                        <a class="btn btn-light btn-sm" asp-action="ServicesPage" asp-controller="Services">
                            <i class="fa fa-caret-left text-dark"></i> ย้อนกลับ
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row gap-2">
                        <!-- ข้อมูลลูกค้า -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="f-w-600 mb-0"><i class="fa fa-briefcase"></i> ข้อมูลลูกค้า</h5>
                                <button id="toggleDetails" class="btn btn-light btn-sm">
                                    <i class="fa fa-eye text-dark"></i> แสดงรายละเอียด
                                </button>
                            </div>
                            <table class="table table-bordered mt-2">
                                <tbody>
                                    <tr>
                                        <th class="bg-light">ชื่อลูกค้า</th>
                                        <td>@(string.IsNullOrEmpty(Model.EmployerName) ? "-" : Model.EmployerName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">ประเภทงาน</th>
                                        <td>@(string.IsNullOrEmpty(Model.ServiceTypeName) ? "-" : Model.ServiceTypeName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">รายการที่รับทำ</th>
                                        <td>@(string.IsNullOrEmpty(Model.ServiceItemName) ? "-" : Model.ServiceItemName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">วันที่บันทึกข้อมูล</th>
                                        <td>@(Model.RecordDate == null ? "-" : Model.RecordDate)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">ชื่อนายหน้า</th>
                                        <td>@(string.IsNullOrEmpty(Model.SignatureName) ? "-" : Model.SignatureName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">หมายเลขใบเสนอราคา</th>
                                        <td>@(string.IsNullOrEmpty(Model.QuotationNumber) ? "-" : Model.QuotationNumber)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">จำนวนคนที่คาดว่าจะรับ</th>
                                        <td>@(Model.ExpectedPeople == null ? "-" : Model.ExpectedPeople)</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- ส่วนรายละเอียดเพิ่มเติม -->
                        <div id="detailsSection" class="col-12" style="display: none;">
                            <div class="row">
                                <!-- ข้อมูลการเงิน -->
                                <div class="col-6">
                                    <h5 class="f-w-600"><i class="fa fa-money"></i> ข้อมูลการเงิน</h5>
                                    <table class="table table-bordered mt-2">
                                        <tbody>
                                            <tr>
                                                <th class="bg-light">ราคารวม</th>
                                                <td>@(Model.TotalPrice == null ? "-" : Model.TotalPrice)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">เงินมัดจำ</th>
                                                <td>@(Model.Deposit == null ? "-" : Model.Deposit)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">จ่ายยอดค้างชำระ</th>
                                                <td>@(Model.RemainingPayment == null ? "-" : Model.RemainingPayment)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">ยอดค้างชำระทั้งหมด</th>
                                                <td>@(Model.OutstandingAmount == null ? "-" : Model.OutstandingAmount)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- รายละเอียดเพิ่มเติม -->
                                <div class="col-6">
                                    <h5 class="f-w-600"><i class="fa fa-list-alt"></i> รายละเอียดเพิ่มเติม</h5>
                                    <table class="table table-bordered mt-2">
                                        <tbody>
                                            <tr>
                                                <th class="bg-light">ต่างด้าวเป็น MOU</th>
                                                <td>
                                                    @if (Model.IsMou)
                                                    {
                                                        <i class="fa fa-check-circle text-success" style="font-size: 0.8rem"> ใช่</i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-times-circle text-secondary" style="font-size: 0.8rem"> ไม่ใช่</i>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">ส่งงานบัญชีแล้ว</th>
                                                <td>
                                                    @if (Model.IsSentToAccounting)
                                                    {
                                                        <i class="fa fa-check-circle text-success" style="font-size: 0.8rem"> ส่งแล้ว</i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-times-circle text-secondary" style="font-size: 0.8rem"> ยังไม่ส่ง</i>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">หมายเหตุ</th>
                                                <td>@(string.IsNullOrEmpty(Model.Note) ? "-" : Model.Note)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">ผู้บันทึก</th>
                                                <td>@(string.IsNullOrEmpty(Model.Recorder) ? "-" : Model.Recorder)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row" style="display: none" id="showInsert">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <a class="btn btn-light" id="createOff" href="#" style="float:right"><i class="fa fa-close"></i> ยกเลิก</a>
                    <h4 id="createHeader"><i class="fa fa-plus text-dark"></i> เพิ่มข้อมูล</h4>
                    <h4 id="updateHeader" style="display:none"><i class="fa fa-edit"></i> แก้ไขข้อมูล</h4>
                </div>
                <div class="card-body">
                    <form id="myForm" class="row g-3" method="post">
                        <input class="form-control" name="ServiceWorkerID" id="txtServiceWorkerID" type="hidden">
                        <input class="form-control" name="ServiceID" id="txtServiceID" type="hidden" value="@Model.ServiceID">
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="PassportNumber">หมายเลขหนังสือเดินทาง</label>
                            <input type="text" name="PassportNumber" id="txtPassportNumber" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="Nationality">สัญชาติ</label>
                            <input type="text" name="Nationality" id="txtNationality" class="form-control" />
                        </div>
                        <div class="col-xxl-4 col-sm-4">
                            <label class="col-form-label" for="Title">คำนำหน้า</label>
                            <select name="Title" id="ddlTitle" class="form-control select2-In">
                                <option value="Mr">Mr</option>
                                <option value="Mrs">Mrs</option>
                                <option value="Miss">Miss</option>
                                <option value="Dr">Dr</option>
                                <option value="Prof">Prof</option>
                            </select>
                        </div>
                        <div class="col-xxl-4 col-sm-4">
                            <label class="col-form-label" for="FirstNameEN">ชื่อ (ภาษาอังกฤษ)</label>
                            <input type="text" name="FirstNameEN" id="txtFirstNameEN" class="form-control" />
                        </div>
                        <div class="col-xxl-4 col-sm-4">
                            <label class="col-form-label" for="LastNameEN">นามสกุล (ภาษาอังกฤษ)</label>
                            <input type="text" name="LastNameEN" id="txtLastNameEN" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="DateOfBirth">วันเกิด</label>
                            <input type="date" name="DateOfBirth" id="txtDateOfBirth" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="PassportIssueDate">วันที่ออกหนังสือเดินทาง</label>
                            <input type="date" name="PassportIssueDate" id="txtPassportIssueDate" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="PassportExpiryDate">วันหมดอายุหนังสือเดินทาง</label>
                            <input type="date" name="PassportExpiryDate" id="txtPassportExpiryDate" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="WorkPermitNumber">หมายเลขใบอนุญาตทำงาน</label>
                            <input type="text" name="WorkPermitNumber" id="txtWorkPermitNumber" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="EntryVisaNumber">หมายเลขวีซ่าเข้าเมือง</label>
                            <input type="text" name="EntryVisaNumber" id="txtEntryVisaNumber" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="PlaceOfBirth">สถานที่เกิด</label>
                            <input type="text" name="PlaceOfBirth" id="txtPlaceOfBirth" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="PassportIssuedAt">สถานที่ออกหนังสือเดินทาง</label>
                            <input type="text" name="PassportIssuedAt" id="txtPassportIssuedAt" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="Country">ประเทศ</label>
                            <input type="text" name="Country" id="txtCountry" class="form-control" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="ServiceFee">ค่าบริการ</label>
                            <input type="number" name="ServiceFee" id="txtServiceFee" class="form-control" step="0.01" />
                        </div>
                        <div class="col-xxl-6 col-sm-6">
                            <label class="col-form-label" for="Expiry90Days">วันหมดอายุ (90 วัน)</label>
                            <input type="date" name="Expiry90Days" id="txtExpiry90Days" class="form-control" />
                        </div>
                        <div class="col-xxl-12 col-sm-12">
                            <label class="col-form-label" for="Note">บันทึก</label>
                            <textarea name="Note" id="txtNote" class="form-control"></textarea>
                        </div>
                        <div class="col-sm-12 col-xxl-12 col-12 justify-content-between d-flex">
                            <button class="btn btn-primary" id="createBtn" type="submit">บันทึก</button>
                            <button class="btn btn-primary" id="updateBtn" type="submit" style="display: none;">อัพเดท</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="ribbon ribbon-primary ribbon-clip">
                        <i class="fa fa-group"></i> จัดการข้อมูลแรงงาน
                    </div>
                    <div class="d-flex gap-2 justify-end" style="float:right">
                        <a class="btn btn-primary btn-sm" id="createOn" href="#">
                            <i class="fa fa-plus text-white"></i> เพิ่มแรงงาน
                        </a>
                    </div>
                </div>
                <div class="card-body">

                    <div class="table-responsive theme-scrollbar mt-2">
                        <table class="display table table-bordered" style="width:100%">
                            <thead>
                                <tr>
                                    <th class="text-center align-content-md-center" width="5%" rowspan="2">ลำดับ</th>
                                    <th class="text-center align-content-md-center" rowspan="2">เลขบัตรประจำตัว</th>
                                    <th class="text-center align-content-md-center" rowspan="2">ชื่อ-นามสกุลอังกฤษ</th>
                                    <th class="text-center align-content-md-center" rowspan="2">สัญชาติ</th>
                                    <th class="text-center" colspan="3">PASSPORT</th>
                                    <th class="text-center" colspan="2">VISA</th>
                                    <th class="text-center align-content-md-center" rowspan="2">เลขใบอนุญาต</th>
                                    <th class="text-center align-content-md-center" rowspan="2">เลขที่บัตรขาเข้า</th>
                                    <th class="text-center align-content-md-center" rowspan="2">รายละเอียด</th>
                                    <th class="text-center align-content-md-center" rowspan="2">ดำเนินการ</th>
                                </tr>
                                <tr>
                                    <th>หมายเลข</th>
                                    <th>วันที่ออก</th>
                                    <th>วันที่หมดอายุ</th>
                                    <th>วันที่ออก</th>
                                    <th>วันที่หมดอายุ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.WorkerList == null || ((List<ServiceWorker>)ViewBag.WorkerList).Count == 0)
                                {
                                    <tr>
                                        <td colspan="13" class="text-center">ไม่มีข้อมูล</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in (List<ServiceWorker>)ViewBag.WorkerList)
                                    {
                                        countRow++;
                                        <tr>
                                            <td class="text-center">@countRow</td>
                                            <td>@item.PassportNumber</td>
                                            <td>@item.FirstNameEN @item.LastNameEN</td>
                                            <td>@item.Nationality</td>
                                            <td>@item.PassportNumber</td>
                                            <td>@item.PassportIssueDate?.ToString("yyyy-MM-dd")</td>
                                            <td>@item.PassportExpiryDate?.ToString("yyyy-MM-dd")</td>
                                            <td>@item.CreatedAt?.ToString("yyyy-MM-dd")</td>
                                            <td>@item.Expiry90Days?.ToString("yyyy-MM-dd")</td>
                                            <td>@item.WorkPermitNumber</td>
                                            <td>@item.EntryVisaNumber</td>
                                            <td class="text-center">
                                                <button class="btn btn-light btn-sm detailBtn" data-ServiceWorkerID="@item.ServiceWorkerID">
                                                    <i class="fa fa-list-alt"></i>
                                                </button>
                                            </td>
                                            <td>
                                                <ul class="action">
                                                    <li class="edit">
                                                        <a href="#" class="editBtn" data-ServiceWorkerID="@item.ServiceWorkerID">
                                                            <i class="icon-pencil-alt"></i>
                                                        </a>
                                                    </li>
                                                    <li class="delete">
                                                        <a href="#" class="deleteBtn" data-ServiceWorkerID="@item.ServiceWorkerID">
                                                            <i class="icon-trash"></i>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">รายละเอียดเพิ่มเติม</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul>
                    <li><strong>หมายเลขหนังสือเดินทาง:</strong> <span id="passportNumber"></span></li>
                    <li><strong>ชื่อ-นามสกุล:</strong> <span id="fullName"></span></li>
                    <li><strong>สัญชาติ:</strong> <span id="nationality"></span></li>
                    <li><strong>ค่าบริการ:</strong> <span id="serviceFee"></span></li>
                    <li><strong>วันที่หมดอายุ 90 วัน:</strong> <span id="expiry90Days"></span></li>
                    <li><strong>หมายเหตุ:</strong> <span id="note"></span></li>
                    <li><strong>สถานที่เกิด:</strong> <span id="placeOfBirth"></span></li>
                    <li><strong>สถานที่ออกหนังสือเดินทาง:</strong> <span id="passportIssuedAt"></span></li>
                    <li><strong>ประเทศ:</strong> <span id="country"></span></li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var showInsert = document.getElementById('showInsert');
            var createOn = document.getElementById('createOn');
            var createOff = document.getElementById('createOff');

            // Event listener for "เพิ่ม" button
            createOn.addEventListener('click', function (e) {
                e.preventDefault();
                showInsert.style.display = 'block';  // Show the form
            });

            // Event listener for "ยกเลิกเพิ่ม" button
            createOff.addEventListener('click', function (e) {
                e.preventDefault();
                showInsert.style.display = 'none';  // Hide the form
                // Reset the form fields
                $('#myForm')[0].reset();
                // Hide the ServiceWorkerID field and update button
                $('#txtServiceWorkerID').hide();
                $('#updateBtn').hide();
                // Show the create button and header
                $('#createHeader').show();
                $('#updateHeader').hide();
                $('#createBtn').show();
            });

            document.querySelectorAll('.detailBtn').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var serviceWorkerID = this.getAttribute('data-ServiceWorkerID');

                    $.ajax({
                        url: '@Url.Action("GetServiceWorkerDetails", "Services")',
                        type: 'POST',
                        data: { ServiceWorkerID: serviceWorkerID },
                        success: function (response) {
                               console.log(response.data);
                                if (response.success) {
                                    $('#passportNumber').text(response.data.passportNumber || "-");
                                    $('#fullName').text(response.data.firstNameEN + " " + response.data.lastNameEN || "-");
                                    $('#nationality').text(response.data.nationality || "-");
                                    $('#serviceFee').text(response.data.serviceFee || "-");
                                    $('#expiry90Days').text(response.data.expiry90Days || "-");
                                    $('#note').text(response.data.note || "-");
                                    $('#placeOfBirth').text(response.data.placeOfBirth || "-");
                                    $('#passportIssuedAt').text(response.data.passportIssuedAt || "-");
                                    $('#country').text(response.data.country || "-");
                                    $('#detailsModal').modal('show');
                                } else {
                                    alert(response.message);
                                }
                        },
                        error: function (xhr, textStatus, errorThrown) {
                            console.error('Error:', xhr.status, textStatus, errorThrown);
                            handleAjaxError(xhr);
                        }
                    });
                });
            });

            document.getElementById('createBtn').addEventListener('click', function (e) {
                e.preventDefault();

                var formData = new FormData($('#myForm')[0]);

                Swal.fire({
                    title: 'คุณแน่ใจหรือไม่?',
                    text: "คุณจะไม่สามารถย้อนกลับได้!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745', // Light green
                    cancelButtonColor: '#d3d3d3', // Light gray
                    confirmButtonText: 'ใช่, บันทึก!',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("CreateServiceWorker", "Services")',
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success == true) {
                                    Swal.fire(
                                        'บันทึกแล้ว!',
                                        'ข้อมูลของคุณถูกบันทึกแล้ว.',
                                        'success'
                                    ).then((result) => {
                                        if (result.isConfirmed) {
                                            window.location.reload();
                                        }
                                    });
                                } else {
                                    Swal.fire('ผิดพลาด', response.message, 'error');
                                }
                            },
                            error: function (xhr, textStatus, errorThrown) {
                                console.error('Error:', xhr.status, textStatus, errorThrown);
                                handleAjaxError(xhr);
                            }
                        });
                    }
                });
            });

            // แก้ไขข้อมูลพนักงาน
            document.querySelectorAll('.editBtn').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var serviceWorkerID = this.getAttribute('data-ServiceWorkerID');

                    $.ajax({
                        url: '@Url.Action("GetServiceWorkerDetails", "Services")',
                        type: 'POST',
                        data: { ServiceWorkerID: serviceWorkerID },
                        success: function (response) {
                            if (response.success == false) {
                                Swal.fire('ผิดพลาด', response.message, 'error');
                            } else {
                                $('#showInsert').show();
                                $('#txtServiceWorkerID').val(response.data.serviceWorkerID);
                                $('#txtPassportNumber').val(response.data.passportNumber);
                                $('#txtNationality').val(response.data.nationality);
                                $('#txtFirstNameEN').val(response.data.firstNameEN);
                                $('#txtLastNameEN').val(response.data.lastNameEN);
                                $('#txtServiceFee').val(response.data.serviceFee);
                                $('#txtExpiry90Days').val(response.data.expiry90Days);
                                $('#txtNote').val(response.data.note);

                                $('#createHeader').hide();
                                $('#updateHeader').show();
                                $('#createBtn').hide();
                                $('#updateBtn').show();
                            }
                        },
                        error: function (xhr, textStatus, errorThrown) {
                            console.error('Error:', xhr.status, textStatus, errorThrown);
                            handleAjaxError(xhr);
                        }
                    });
                });
            });

            // ลบข้อมูลพนักงาน
            document.querySelectorAll('.deleteBtn').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var serviceWorkerID = this.getAttribute('data-ServiceWorkerID');

                    Swal.fire({
                        title: 'คุณแน่ใจหรือไม่?',
                        text: "คุณจะไม่สามารถย้อนกลับได้!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#d3d3d3',
                        confirmButtonText: 'ใช่, ลบ!',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '@Url.Action("DeleteServiceWorker", "Services")',
                                type: 'POST',
                                data: { ServiceWorkerID: serviceWorkerID },
                                success: function (response) {
                                    if (response.success) {
                                        Swal.fire(
                                            'ลบแล้ว!',
                                            response.message,
                                            'success'
                                        ).then((result) => {
                                            if (result.isConfirmed) {
                                                window.location.reload();
                                            }
                                        });
                                    } else {
                                        Swal.fire('ผิดพลาด', response.message, 'error');
                                    }
                                },
                                error: function (xhr, textStatus, errorThrown) {
                                    console.error('Error:', xhr.status, textStatus, errorThrown);
                                    handleAjaxError(xhr);
                                }
                            });
                        }
                    });
                });
            });

            document.getElementById('updateBtn').addEventListener('click', function (e) {
                e.preventDefault();

                var formData = new FormData($('#myForm')[0]);

                Swal.fire({
                    title: 'คุณแน่ใจหรือไม่?',
                    text: "คุณจะไม่สามารถย้อนกลับได้!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#007bff', // Light blue
                    cancelButtonColor: '#d3d3d3', // Light gray
                    confirmButtonText: 'ใช่, บันทึก!',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("UpdateServiceWorker", "Services")',
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success == true) {
                                    Swal.fire(
                                        'บันทึกแล้ว!',
                                        'ข้อมูลของคุณถูกบันทึกแล้ว.',
                                        'success'
                                    ).then((result) => {
                                        if (result.isConfirmed) {
                                            window.location.reload();
                                        }
                                    })
                                } else {
                                    Swal.fire('ผิดพลาด', response.message, 'error');
                                }
                            },
                            error: function (xhr, textStatus, errorThrown) {
                                handleAjaxError(xhr);
                            }
                        });
                    }
                });
            });

            document.getElementById('toggleDetails').addEventListener('click', function () {
                var detailsSection = document.getElementById('detailsSection');
                if (detailsSection.style.display === 'none') {
                    detailsSection.style.display = 'block';
                    this.innerHTML = '<i class="fa fa-eye-slash text-dark"></i> ซ่อนรายละเอียด';
                } else {
                    detailsSection.style.display = 'none';
                    this.innerHTML = '<i class="fa fa-eye text-dark"></i> แสดงรายละเอียด';
                }
            });

            function handleAjaxError(xhr) {
                console.log('Error:', xhr.status, xhr.statusText);

                switch (xhr.status) {
                    case 400:
                        window.open('@Url.Action("Error400", "Error")', '_blank');
                        break;
                    case 401:
                        window.open('@Url.Action("Error401", "Error")', '_blank');
                        break;
                    case 403:
                        window.open('@Url.Action("Error403", "Error")', '_blank');
                        break;
                    case 404:
                        window.open('@Url.Action("Error404", "Error")', '_blank');
                        break;
                    case 500:
                        window.open('@Url.Action("Error500", "Error")', '_blank');
                        break;
                    case 503:
                        window.open('@Url.Action("Error503", "Error")', '_blank');
                        break;
                    default:
                        console.log('An unexpected error occurred: ', xhr.status);
                }
            }
        });
    </script>
}

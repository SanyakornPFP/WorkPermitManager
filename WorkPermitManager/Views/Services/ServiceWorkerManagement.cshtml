            document.querySelectorAll('.reportPowerOfAttorney').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();

                    var employerID = $(this).data('employerid');

                    $.ajax({
                        url: '@Url.Action("ReportPowerOfAttorney", "Employers")',
                        type: 'GET',
                        data: { EmployerID: employerID },
                        success: function(response) {
                            if (response.success) {
                               // แปลง Base64 เป็น Blob และเปิดในแท็บใหม่
                                var byteCharacters = atob(response.file);
                                var byteNumbers = new Array(byteCharacters.length);
                                for (var i = 0; i < byteCharacters.length; i++) {
                                    byteNumbers[i] = byteCharacters.charCodeAt(i);
                                }
                                var byteArray = new Uint8Array(byteNumbers);
                                var blob = new Blob([byteArray], { type: 'application/pdf' });
                                var url = URL.createObjectURL(blob);
                                window.open(url, '_blank');
                            } else {
                                Swal.fire({
                                    title: 'ผิดพลาด',
                                    text: response.message,
                                    icon: 'error'
                                }).then((result) => {
                                    if (result.isConfirmed && response.redirectUrl) {
                                        window.location.href = response.redirectUrl;
                                    }
                                });
                            }
                        },
                        error: function(xhr, textStatus, errorThrown) {
                            console.error('Error:', xhr.status, textStatus, errorThrown);
                            Swal.fire('ผิดพลาด', 'เกิดข้อผิดพลาดในการสร้างรายงาน', 'error');
                        }
                    });
                });
            });
        });

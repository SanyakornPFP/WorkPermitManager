@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var showInsert = document.getElementById('showInsert');
            var createOn = document.getElementById('createOn');
            var createOff = document.getElementById('createOff');

            createOn.addEventListener('click', function (e) {
                e.preventDefault();
                showInsert.style.display = 'block';  // Show the form
            });

            createOff.addEventListener('click', function (e) {
                e.preventDefault();
                showInsert.style.display = 'none';  // Hide the form
                // Reset the form fields
                $('#myForm')[0].reset();
                // Hide the ServiceWorkerID field and update button
                $('#txtServiceWorkerID').hide();
                $('#updateBtn').hide();
                // Show the create button and header
                $('#createHeader').show();
                $('#updateHeader').hide();
                $('#createBtn').show();
            });

            document.querySelectorAll('.detailBtn').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var serviceWorkerID = this.getAttribute('data-ServiceWorkerID');

                    $.ajax({
                        url: '@Url.Action("GetServiceWorkerDetails", "Services")',
                        type: 'POST',
                        data: { ServiceWorkerID: serviceWorkerID },
                        success: function (response) {
                            console.log(response.data);
                            if (response.success) {
                                // ข้อมูลแรงงาน
                                $('#title').text(response.data.title || "-");
                                $('#fullName').text((response.data.firstNameEN + " " + response.data.lastNameEN) || "-");
                                $('#dateOfBirth').text(formatDate(response.data.dateOfBirth, "dd/MM/yyyy") || "-");
                                $('#bloodType').text(response.data.bloodType || "-");
                                $('#placeOfBirth').text(response.data.placeOfBirth || "-");
                                $('#nationality').text(response.data.nationality || "-");
                                $('#country').text(response.data.country || "-");
                                $('#note').text(response.data.note || "-");

                                // ข้อมูลพาสปอร์ต
                                $('#passportNumber').text(response.data.passportNumber || "-");
                                $('#passportIssuedAt').text(response.data.passportIssuedAt || "-");
                                $('#passportDateOfIssue').text(formatDate(response.data.passportDateOfIssue, "dd/MM/yyyy") || "-");
                                $('#passportExpiryDate').text(formatDate(response.data.passportExpiryDate, "dd/MM/yyyy") || "-");

                                // ข้อมูลวีซ่า
                                $('#typeVisa').text(response.data.typeVisa || "-");
                                $('#visaNumber').text(response.data.visaNumber || "-");
                                $('#visaDateOfIssue').text(formatDate(response.data.visaDateOfIssue, "dd/MM/yyyy") || "-");
                                $('#visaExpiryDate').text(formatDate(response.data.visaExpiryDate, "dd/MM/yyyy") || "-");
                                $('#visaIssuedAt').text(response.data.visaIssuedAt || "-");

                                // ข้อมูลการเดินทางเข้าเมือง
                                $('#dateOfArrival').text(formatDate(response.data.dateOfArrival, "dd/MM/yyyy") || "-");
                                $('#immigrationCheckpoint').text(response.data.immigrationCheckpoint || "-");
                                $('#permittedUntil').text(formatDate(response.data.permittedUntil, "dd/MM/yyyy") || "-");

                                // ข้อมูลใบสำคัญถิ่นที่อยู่
                                $('#residenceNo').text(response.data.residenceNo || "-");
                                $('#residenceIssuedAt').text(response.data.residenceIssuedAt || "-");
                                $('#residenceProvince').text(response.data.residenceProvince || "-");
                                $('#residenceDateOfIssue').text(formatDate(response.data.residenceDateOfIssue, "dd/MM/yyyy") || "-");
                                $('#residenceExpiryDate').text(formatDate(response.data.residenceExpiryDate, "dd/MM/yyyy") || "-");

                                // ข้อมูลใบสำคัญประจำตัวคนต่างด้าว
                                $('#alienNo').text(response.data.alienNo || "-");
                                $('#alienIssuedAt').text(response.data.alienIssuedAt || "-");
                                $('#alienProvince').text(response.data.alienProvince || "-");
                                $('#alienDateOfIssue').text(formatDate(response.data.alienDateOfIssue, "dd/MM/yyyy") || "-");
                                $('#alienExpiryDate').text(formatDate(response.data.alienExpiryDate, "dd/MM/yyyy") || "-");

                                // ข้อมูลการทำงาน
                                $('#workPermitActionType').text(response.data.workPermitActionType || "-");
                                $('#workPermitNumber').text(response.data.workPermitNumber || "-");
                                $('#workPermitIssuedAtProvince').text(response.data.workPermitIssuedAtProvince || "-");
                                $('#workPermitDateOfIssue').text(formatDate(response.data.workPermitDateOfIssue, "dd/MM/yyyy") || "-");
                                $('#workPermitExpiryDate').text(formatDate(response.data.workPermitExpiryDate, "dd/MM/yyyy") || "-");

                                // ข้อมูลการเงิน
                                $('#serviceFee').text(response.data.serviceFee || "-");
                                $('#expiry90Days').text(formatDate(response.data.expiry90Days, "dd/MM/yyyy") || "-");
                                $('#createdAt').text(formatDate(response.data.createdAt, "dd/MM/yyyy hh:mm:ss") || "-");
                                $('#userCreate').text(response.data.userCreate || "-");

                                // แสดง Modal
                                $('#detailsModal').modal('show');
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function (xhr, textStatus, errorThrown) {
                            console.error('Error:', xhr.status, textStatus, errorThrown);
                            handleAjaxError(xhr);
                        }
                    });
                });
            });

            document.getElementById('createBtn').addEventListener('click', function (e) {
                e.preventDefault();

                var formData = new FormData($('#myForm')[0]);

                Swal.fire({
                    title: 'คุณแน่ใจหรือไม่?',
                    text: "คุณจะไม่สามารถย้อนกลับได้!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745', // Light green
                    cancelButtonColor: '#d3d3d3', // Light gray
                    confirmButtonText: 'ใช่, บันทึก!',
                    cancelButtonText: 'ยกเลิก'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("CreateServiceWorker", "Services")',
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success == true) {
                                    Swal.fire(
                                        'บันทึกแล้ว!',
                                        'ข้อมูลของคุณถูกบันทึกแล้ว.',
                                        'success'
                                    ).then((result) => {
                                        if (result.isConfirmed) {
                                            window.location.reload();
                                        }
                                    });
                                } else {
                                    Swal.fire('ผิดพลาด', response.message, 'error');
                                }
                            },
                            error: function (xhr, textStatus, errorThrown) {
                                console.error('Error:', xhr.status, textStatus, errorThrown);
                                handleAjaxError(xhr);
                            }
                        });
                    }
                });
            });

            document.querySelectorAll('.editBtn').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var serviceWorkerID = this.getAttribute('data-ServiceWorkerID');

                    // Perform AJAX request to get service worker details
                    $.ajax({
                        url: '@Url.Action("GetServiceWorkerDetails", "Services")',
                        type: 'POST',
                        data: { ServiceWorkerID: serviceWorkerID },
                        success: function (response) {
                            if (response.success === false) {
                                Swal.fire('ผิดพลาด', response.message, 'error');
                            } else {
                                console.log(response.data);
                                // Show the form for editing
                                $('#showInsert').show();
                                // Populate form fields with fetched data
                                $('#txtServiceWorkerID').val(response.data.serviceWorkerID);
                                $('#ddlNationality').val(response.data.nationality).trigger('change');
                                $('#ddlTitle').val(response.data.title).trigger('change'); // Select2 needs trigger('change')
                                $('#txtFirstNameEN').val(response.data.firstNameEN);
                                $('#txtLastNameEN').val(response.data.lastNameEN);
                                $('#txtDateOfBirth').val(formatDateToInput(response.data.dateOfBirth));
                                $('#ddlBloodType').val(response.data.bloodType).trigger('change');
                                $('#ddlTypeVisa').val(response.data.typeVisa).trigger('change');
                                $('#txtVisaNumber').val(response.data.visaNumber);
                                $('#txtVisaDateOfIssue').val(formatDateToInput(response.data.visaDateOfIssue));
                                $('#txtVisaExpiryDate').val(formatDateToInput(response.data.visaExpiryDate));
                                $('#txtVisaIssuedAt').val(response.data.visaIssuedAt);
                                $('#txtPassportNumber').val(response.data.passportNumber);
                                $('#txtPassportDateOfIssue').val(formatDateToInput(response.data.passportDateOfIssue));
                                $('#txtPassportExpiryDate').val(formatDateToInput(response.data.passportExpiryDate));
                                $('#txtPassportIssuedAt').val(response.data.passportIssuedAt);
                                $('#txtExpiry90Days').val(formatDateToInput(response.data.expiry90Days));
                                $('#txtPlaceOfBirth').val(response.data.placeOfBirth);
                                $('#txtCountry').val(response.data.country);
                                $('#txtDateOfArrival').val(formatDateToInput(response.data.dateOfArrival));
                                $('#txtImmigrationCheckpoint').val(response.data.immigrationCheckpoint);
                                $('#txtPermittedUntil').val(formatDateToInput(response.data.permittedUntil));
                                $('#txtResidenceNo').val(response.data.residenceNo);
                                $('#txtResidenceIssuedAt').val(response.data.residenceIssuedAt);
                                $('#ddlResidenceProvince').val(response.data.residenceProvince).trigger('change');
                                $('#txtResidenceDateOfIssue').val(formatDateToInput(response.data.residenceDateOfIssue));
                                $('#txtResidenceExpiryDate').val(formatDateToInput(response.data.residenceExpiryDate));

                                    <th class="text-center bg-light" colspan="3">PASSPORT</th>
                                    <th class="text-center bg-light" colspan="3">VISA</th>
                                    <th class="text-center align-content-md-center bg-light" rowspan="2">รายละเอียด</th>
                                    <th class="text-center align-content-md-center bg-light" rowspan="2">ดำเนินการ</th>
                                </tr>
                                <tr>
                                    <th class="bg-light text-center">เลขใบอนุญาต</th>
                                    <th class="bg-light text-center">วันที่ออก</th>
                                    <th class="bg-light text-center">วันที่หมดอายุ</th>
                                    <th class="bg-light text-center">เลขใบอนุญาต</th>
                                    <th class="bg-light text-center">วันที่ออก</th>
                                    <th class="bg-light text-center">วันที่หมดอายุ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.WorkerList == null || ((List<ServiceWorker>)ViewBag.WorkerList).Count == 0)
                                {
                                    <tr>
                                        <td colspan="14" class="text-center">ไม่มีข้อมูล</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in (List<ServiceWorker>)ViewBag.WorkerList)
                                    {
                                        countRow++;
                                        <tr>
                                            <td class="text-center">
                                                <input type="checkbox" class="selectRow" data-ServiceWorkerID="@item.ServiceWorkerID" />
                                            </td>
                                            <td class="text-center">@countRow</td>
                                            <td>@item.PassportNumber</td>
                                            <td>@item.Title@item.FirstNameEN @item.LastNameEN</td>
                                            <td>@item.Nationality</td>
                                            <td class="text-center">@item.PassportNumber</td>
                                            <td class="text-center">@(item.PassportDateOfIssue?.ToString("dd/MM/yyyy"))</td>
                                            <td class="text-center">@(item.PassportExpiryDate?.ToString("dd/MM/yyyy"))</td>
                                            <td class="text-center">@item.VisaNumber</td>
                                            <td class="text-center">@(item.CreatedAt?.ToString("dd/MM/yyyy"))</td>
                                            <td class="text-center">@(item.Expiry90Days?.ToString("dd/MM/yyyy"))</td>
                                            <td class="text-center">
                                                <button class="btn detailBtn" data-ServiceWorkerID="@item.ServiceWorkerID">
                                                    <i class="fa fa-list-alt"></i>
                                                </button>
                                            </td>
                                            <td>
                                                <ul class="action">
                                                    <li class="edit">
                                                        <a href="#" class="editBtn" data-ServiceWorkerID="@item.ServiceWorkerID">
                                                            <i class="icon-pencil-alt"></i>
                                                        </a>
                                                    </li>
                                                    <li class="delete">
                                                        <a href="#" class="deleteBtn" data-ServiceWorkerID="@item.ServiceWorkerID">
                                                            <i class="icon-trash"></i>
                                                        </a>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


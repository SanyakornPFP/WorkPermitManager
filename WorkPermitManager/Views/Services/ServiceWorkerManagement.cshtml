@{
    ViewData["Controller"] = "งานบริการ";
    ViewData["Action"] = "ข้อมูลแรงงาน";
    ViewData["Icon"] = "paste";
    int countRow = 0;
}
<!-- Container-fluid starts-->
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="ribbon ribbon-primary ribbon-clip">
                        <i class="fa fa-paste"></i> รายละเอียดงานบริการ
                    </div>
                    <div class="d-flex gap-2 justify-end" style="float:right">
                        <a class="btn btn-light btn-sm" asp-action="ServicesPage" asp-controller="Services">
                            <i class="fa fa-caret-left text-dark"></i> ย้อนกลับ
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row gap-2">
                        <!-- ข้อมูลลูกค้า -->
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="f-w-600 mb-0"><i class="fa fa-briefcase"></i> ข้อมูลลูกค้า</h5>
                                <div>
                                    <a class="btn btn-success btn-sm reportPowerOfAttorney" data-employerid="@Model.EmployerID" href="#">
                                        <i class="fa fa-file-pdf-o text-white"></i> พิมพ์ใบมอบอำนาจนายจ้าง
                                    </a>
                                    <button id="toggleDetails" class="btn btn-light btn-sm">
                                        <i class="fa fa-eye text-dark"></i> แสดงรายละเอียด
                                    </button>
                                </div>
                            </div>
                            <table class="table table-bordered mt-2">
                                <tbody>
                                    <tr>
                                        <th class="bg-light">ชื่อลูกค้า</th>
                                        <td>@(string.IsNullOrEmpty(Model.EmployerName) ? "-" : Model.EmployerName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">ประเภทงาน</th>
                                        <td>@(string.IsNullOrEmpty(Model.ServiceTypeName) ? "-" : Model.ServiceTypeName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">รายการที่รับทำ</th>
                                        <td>@(string.IsNullOrEmpty(Model.ServiceItemName) ? "-" : Model.ServiceItemName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">วันที่บันทึกข้อมูล</th>
                                        <td>@(Model.RecordDate == null ? "-" : Model.RecordDate)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">ชื่อนายหน้า</th>
                                        <td>@(string.IsNullOrEmpty(Model.SignatureName) ? "-" : Model.SignatureName)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">หมายเลขใบเสนอราคา</th>
                                        <td>@(string.IsNullOrEmpty(Model.QuotationNumber) ? "-" : Model.QuotationNumber)</td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">จำนวนคนที่คาดว่าจะรับ</th>
                                        <td>@(Model.ExpectedPeople == null ? "-" : Model.ExpectedPeople)</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- ส่วนรายละเอียดเพิ่มเติม -->
                        <div id="detailsSection" class="col-12" style="display: none;">
                            <div class="row">
                                <!-- ข้อมูลการเงิน -->
                                <div class="col-6">
                                    <h5 class="f-w-600"><i class="fa fa-money"></i> ข้อมูลการเงิน</h5>
                                    <table class="table table-bordered mt-2">
                                        <tbody>
                                            <tr>
                                                <th class="bg-light">ราคารวม</th>
                                                <td>@(Model.TotalPrice == null ? "-" : Model.TotalPrice)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">เงินมัดจำ</th>
                                                <td>@(Model.Deposit == null ? "-" : Model.Deposit)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">จ่ายยอดค้างชำระ</th>
                                                <td>@(Model.RemainingPayment == null ? "-" : Model.RemainingPayment)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">ยอดค้างชำระทั้งหมด</th>
                                                <td>@(Model.OutstandingAmount == null ? "-" : Model.OutstandingAmount)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- รายละเอียดเพิ่มเติม -->
                                <div class="col-6">
                                    <h5 class="f-w-600"><i class="fa fa-list-alt"></i> รายละเอียดเพิ่มเติม</h5>
                                    <table class="table table-bordered mt-2">
                                        <tbody>
                                            <tr>
                                                <th class="bg-light">ต่างด้าวเป็น MOU</th>
                                                <td>
                                                    @if (Model.IsMou)
                                                    {
                                                        <i class="fa fa-check-circle text-success" style="font-size: 0.8rem"> ใช่</i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-times-circle text-secondary" style="font-size: 0.8rem"> ไม่ใช่</i>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">ส่งงานบัญชีแล้ว</th>
                                                <td>
                                                    @if (Model.IsSentToAccounting)
                                                    {
                                                        <i class="fa fa-check-circle text-success" style="font-size: 0.8rem"> ส่งแล้ว</i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa fa-times-circle text-secondary" style="font-size: 0.8rem"> ยังไม่ส่ง</i>
                                                    }
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">หมายเหตุ</th>
                                                <td>@(string.IsNullOrEmpty(Model.Note) ? "-" : Model.Note)</td>
                                            </tr>
                                            <tr>
                                                <th class="bg-light">ผู้บันทึก</th>
                                                <td>@(string.IsNullOrEmpty(Model.Recorder) ? "-" : Model.Recorder)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row" style="display: none" id="showInsert">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <a class="btn btn-light" id="createOff" href="#" style="float:right"><i class="fa fa-close"></i> ยกเลิก</a>
                    <h4 id="createHeader"><i class="fa fa-plus text-dark"></i> เพิ่มข้อมูล</h4>
                    <h4 id="updateHeader" style="display:none"><i class="fa fa-edit"></i> แก้ไขข้อมูล</h4>
                </div>
                <div class="card-body">
                    <form id="myForm" class="row g-3" method="post">
                        <div class="border p-3 mb-1 bg-light text-dark">
                            <h5>ข้อมูลแรงงานและบริการ (Basic Information)</h5>
                            <div class="row">
                                <input class="form-control" name="ServiceWorkerID" id="txtServiceWorkerID" type="hidden">
                                <input class="form-control" name="ServiceID" id="txtServiceID" type="hidden" value="@Model.ServiceID">
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="Title">คำนำหน้า</label>
                                    <select name="Title" id="ddlTitle" class="form-control ">
                                        <option value="Mr.">Mr</option>
                                        <option value="Ms.">Ms</option>
                                        <option value="Mrs.">Mrs</option>
                                        <option value="Miss.">Miss</option>
                                        <option value="Dr.">Dr</option>
                                        <option value="Prof.">Prof</option>
                                    </select>
                                </div>
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="FirstNameEN">ชื่อ (ภาษาอังกฤษ)</label>
                                    <input type="text" name="FirstNameEN" id="txtFirstNameEN" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="LastNameEN">นามสกุล (ภาษาอังกฤษ)</label>
                                    <input type="text" name="LastNameEN" id="txtLastNameEN" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="BloodType">กรุ๊ปเลือด</label>
                                    <select name="BloodType" id="ddlBloodType" class="form-control select2-In">
                                        <option value="">เลือกกรุ๊ปเลือด</option>
                                        <option value="None">ไม่ระบุ</option>
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="AB">AB</option>
                                        <option value="O">O</option>
                                    </select>
                                </div>
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="DateOfBirth">วันเกิด</label>
                                    <input type="date" name="DateOfBirth" id="txtDateOfBirth" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="PlaceOfBirth">สถานที่เกิด</label>
                                    <input type="text" name="PlaceOfBirth" id="txtPlaceOfBirth" class="form-control" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="Nationality">สัญชาติ</label>
                                    <select name="Nationality" id="ddlNationality" class="form-control select2-In">
                                        <option value="">เลือกสัญชาติ</option>
                                        <option value="ไทย">ไทย</option>
                                        <option value="เมียนมา">เมียนมา</option>
                                        <option value="กัมพูชา">กัมพูชา</option>
                                        <option value="ลาว">ลาว</option>
                                        <option value="เวียดนาม">เวียดนาม</option>
                                        <!-- เพิ่มตัวเลือกอื่น ๆ ตามต้องการ -->
                                    </select>
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="Country">ประเทศ</label>
                                    <input type="text" name="Country" id="txtCountry" class="form-control" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="ServiceFee">ค่าบริการ</label>
                                    <input type="number" name="ServiceFee" id="txtServiceFee" class="form-control" step="0.01" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="Expiry90Days">วันหมดอายุ (90 วัน)</label>
                                    <input type="date" name="Expiry90Days" id="txtExpiry90Days" class="form-control" />
                                </div>
                                <div class="col-xxl-12 col-sm-12">
                                    <label class="col-form-label" for="Note">บันทึก</label>
                                    <textarea name="Note" id="txtNote" class="form-control"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="border p-3 mb-1">
                            <h5>ข้อมูลพาสปอร์ต (Passport Information)</h5>
                            <div class="row">
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="PassportNumber">หมายเลขหนังสือเดินทาง</label>
                                    <input type="text" name="PassportNumber" id="txtPassportNumber" class="form-control" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="PassportIssuedAt">สถานที่ออกหนังสือเดินทาง</label>
                                    <input type="text" name="PassportIssuedAt" id="txtPassportIssuedAt" class="form-control" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="PassportDateOfIssue">วันที่ออกหนังสือเดินทาง</label>
                                    <input type="date" name="PassportDateOfIssue" id="txtPassportDateOfIssue" class="form-control" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="PassportExpiryDate">วันหมดอายุหนังสือเดินทาง</label>
                                    <input type="date" name="PassportExpiryDate" id="txtPassportExpiryDate" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="border p-3 mb-1">
                            <h5>ข้อมูลวีซ่า (Visa Information)</h5>
                            <div class="row">
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="TypeVisa">ประเภทวีซ่า</label>
                                    <select name="TypeVisa" id="ddlTypeVisa" class="form-control select2-In">
                                        <option value="Non-LA" selected>Non-LA/แรงงาน</option>
                                    </select>
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="VisaNumber">หมายเลขวีซ่า</label>
                                    <input type="text" name="VisaNumber" id="txtVisaNumber" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-6">
                                    <label class="col-form-label" for="VisaDateOfIssue">วันที่ออกวีซ่า</label>
                                    <input type="date" name="VisaDateOfIssue" id="txtVisaDateOfIssue" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-6">
                                    <label class="col-form-label" for="VisaExpiryDate">วันหมดอายุวีซ่า</label>
                                    <input type="date" name="VisaExpiryDate" id="txtVisaExpiryDate" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-6">
                                    <label class="col-form-label" for="VisaIssuedAt">สถานที่ออกวีซ่า</label>
                                    <input type="text" name="VisaIssuedAt" id="txtVisaIssuedAt" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="border p-3 mb-1">
                            <h5>ข้อมูลการเดินทางเข้าเมือง (Immigration Information)</h5>
                            <div class="row">
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="DateOfArrival">วันที่เดินทางถึง</label>
                                    <input type="date" name="DateOfArrival" id="txtDateOfArrival" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="ImmigrationCheckpoint">ด่านตรวจคนเข้าเมือง</label>
                                    <input type="text" name="ImmigrationCheckpoint" id="txtImmigrationCheckpoint" class="form-control" />
                                </div>
                                <div class="col-xxl-4 col-sm-4">
                                    <label class="col-form-label" for="PermittedUntil">วันที่อนุญาตให้อยู่ถึง</label>
                                    <input type="date" name="PermittedUntil" id="txtPermittedUntil" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="border p-3 mb-1">
                            <h5>ข้อมูลใบสำคัญถิ่นที่อยู่ (Residence Information)</h5>
                            <div class="row">
                                <div class="col-xxl-12 col-sm-12">
                                    <label class="col-form-label" for="ResidenceNo">เลขที่ใบสำคัญถิ่นที่อยู่</label>
                                    <input type="text" name="ResidenceNo" id="txtResidenceNo" class="form-control" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="ResidenceIssuedAt">สถานที่ออกใบสำคัญถิ่นที่อยู่</label>
                                    <input type="text" name="ResidenceIssuedAt" id="txtResidenceIssuedAt" class="form-control" />
                                </div>
                                <div class="col-xxl-6 col-sm-6">
                                    <label class="col-form-label" for="ResidenceProvince">จังหวัดที่ออกใบสำคัญถิ่นที่อยู่</label>
                                    <select name="ResidenceProvince" id="ddlResidenceProvince" class="form-control select2-In">
                                        <option value="" selected>เลือก</option>
                                        <option value="กรุงเทพมหานคร">กรุงเทพมหานคร</option>
                                        <option value="กระบี่">กระบี่</option>
                                        <option value="กาญจนบุรี">กาญจนบุรี</option>
                                        <option value="กาฬสินธุ์">กาฬสินธุ์</option>
                                        <option value="กำแพงเพชร">กำแพงเพชร</option>
                                        <option value="ขอนแก่น">ขอนแก่น</option>
                                        <option value="จันทบุรี">จันทบุรี</option>
                                        <option value="ฉะเชิงเทรา">ฉะเชิงเทรา</option>
                                        <option value="ชลบุรี">ชลบุรี</option>
                                        <option value="ชัยนาท">ชัยนาท</option>
                                        <option value="ชัยภูมิ">ชัยภูมิ</option>
                                        <option value="ชุมพร">ชุมพร</option>
                                        <option value="เชียงราย">เชียงราย</option>
                                        <option value="เชียงใหม่">เชียงใหม่</option>
                                        <option value="ตรัง">ตรัง</option>
                                        <option value="ตราด">ตราด</option>
                                        <option value="ตาก">ตาก</option>
                                        <option value="นครนายก">นครนายก</option>
                                        <option value="นครปฐม">นครปฐม</option>
                                        <option value="นครพนม">นครพนม</option>
                                        <option value="นครราชสีมา">นครราชสีมา</option>
                                        <option value="นครศรีธรรมราช">นครศรีธรรมราช</option>
                                        <option value="นครสวรรค์">นครสวรรค์</option>
                                        <option value="นนทบุรี">นนทบุรี</option>
                                        <option value="นราธิวาส">นราธิวาส</option>
                                        <option value="น่าน">น่าน</option>
                                        <option value="บึงกาฬ">บึงกาฬ</option>
                                        <option value="บุรีรัมย์">บุรีรัมย์</option>
                                        <option value="ปทุมธานี">ปทุมธานี</option>
                                        <option value="ประจวบคีรีขันธ์">ประจวบคีรีขันธ์</option>
                                        <option value="ปราจีนบุรี">ปราจีนบุรี</option>
                                        <option value="ปัตตานี">ปัตตานี</option>
                                        <option value="พะเยา">พะเยา</option>
                                        <option value="พระนครศรีอยุธยา">พระนครศรีอยุธยา</option>
                                        <option value="พังงา">พังงา</option>
                                        <option value="พัทลุง">พัทลุง</option>
                                        <option value="พิจิตร">พิจิตร</option>
                                        <option value="พิษณุโลก">พิษณุโลก</option>
                                        <option value="เพชรบุรี">เพชรบุรี</option>
                                        <option value="เพชรบูรณ์">เพชรบูรณ์</option>
                                        <option value="แพร่">แพร่</option>
                                        <option value="พะเยา">พะเยา</option>
                                        <option value="ภูเก็ต">ภูเก็ต</option>
                                        <option value="มหาสารคาม">มหาสารคาม</option>
                                        <option value="มุกดาหาร">มุกดาหาร</option>
                                        <option value="แม่ฮ่องสอน">แม่ฮ่องสอน</option>
                                        <option value="ยโสธร">ยโสธร</option>
                                        <option value="ยะลา">ยะลา</option>
                                        <option value="ร้อยเอ็ด">ร้อยเอ็ด</option>
                                        <option value="ระนอง">ระนอง</option>
                                        <option value="ระยอง">ระยอง</option>
                                        <option value="ราชบุรี">ราชบุรี</option>
                                        <option value="ลพบุรี">ลพบุรี</option>
                                        <option value="ลำปาง">ลำปาง</option>
                                        <option value="ลำพูน">ลำพูน</option>
                                        <option value="เลย">เลย</option>
                                        <option value="ศรีสะเกษ">ศรีสะเกษ</option>
                                        <option value="สกลนคร">สกลนคร</option>
                                        <option value="สงขลา">สงขลา</option>
                                        <option value="สตูล">สตูล</option>
                                        <option value="สมุทรปราการ">สมุทรปราการ</option>
                                        <option value="สมุทรสงคราม">สมุทรสงคราม</option>
                                        <option value="สมุทรสาคร">สมุทรสาคร</option>
                                        <option value="สระแก้ว">สระแก้ว</option>
                                        <option value="สระบุรี">สระบุรี</option>
                                        <option value="สิงห์บุรี">สิงห์บุรี</option>
                                        <option value="สุโขทัย">สุโขทัย</option>
                                        <option value="สุพรรณบุรี">สุพรรณบุรี</option>
                                        <option value="สุราษฎร์ธานี">สุราษฎร์ธานี</option>
                                        <option value="สุรินทร์">สุรินทร์</option>
